{
  "name": "bjjeire.web.systemtests",
  "version": "2.0.0",
  "description": "BjjEire acceptance tests — function-based, parallel-safe, Playwright + TypeScript",
  "main": "index.js",
  "type": "commonjs",
  "lint-staged": {
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "contract:pull": "scripts/pull-openapi-contract.sh",
    "gen:api-schemas": "openapi-ts -f openapi-ts.config.ts",
    "test": "playwright test -c playwright.ui.config.ts",
    "test:docker": "APP_ENV=docker playwright test -c playwright.ui.config.ts",
    "test:docker:api": "APP_ENV=docker playwright test -c playwright.api.config.ts",
    "test:dev": "APP_ENV=dev playwright test -c playwright.ui.config.ts",
    "test:dev:api": "APP_ENV=dev playwright test -c playwright.api.config.ts",
    "test:staging": "APP_ENV=staging playwright test -c playwright.ui.config.ts",
    "test:staging:api": "APP_ENV=staging playwright test -c playwright.api.config.ts",
    "test:smoke": "playwright test -c playwright.acceptance.config.ts -g @smoke",
    "test:acceptance": "playwright test -c playwright.acceptance.config.ts -g '@acceptance'",
    "test:ci": "CI=true playwright test -c playwright.acceptance.config.ts -g '@acceptance' --reporter=list,html",
    "test:snapshots": "playwright test -c playwright.ui.config.ts --project=snapshots",
    "test:a11y": "playwright test -c playwright.ui.config.ts --project=a11y",
    "snapshots:update": "playwright test -c playwright.ui.config.ts --project=snapshots --update-snapshots",
    "test:mobile": "playwright test -c playwright.ui.config.ts --grep @mobile",
    "test:desktop": "playwright test -c playwright.ui.config.ts --grep @desktop",
    "test:shard": "playwright test -c playwright.ui.config.ts --shard",
    "otel:forward": "kubectl port-forward -n observability service/otel-collector 4318:4318",
    "otel:grafana": "kubectl port-forward -n observability service/monitoring-grafana 3000:80",
    "trace": "playwright show-trace --port 0",
    "play-report": "playwright show-report playwright-report",
    "merge-reports": "playwright merge-reports --reporter html,json ./all-blob-reports",
    "allure-report": "allure generate ./allure-results --clean",
    "open-report": "npm run allure-report && allure open ./allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "format": "prettier --write 'tests/**/*.ts' 'src/**/*.ts' 'playwright.config.ts' '**/*.json' '**/*.md' '!package-lock.json' '!dist/**/*' '!build/**/*'",
    "postinstall": "playwright install --with-deps chromium firefox webkit",
    "reinstall": "npx playwright install",
    "install-deps": "npx playwright install-deps"
  },
  "keywords": [
    "playwright",
    "playwright-test",
    "allure-report",
    "web-test-automation",
    "typescript"
  ],
  "author": "Ian O Flynn",
  "license": "ISC",
  "dependencies": {
    "@azure/msal-node": "^7.1.0",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@playwright/test": "^1.64.1",
    "@stoplight/spectral-cli": "^6.17.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3"
  }
}
